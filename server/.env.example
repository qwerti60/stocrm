# Скопируйте в server/.env — SID туда, не сюда (этот файл в git)
STOCRM_DOMAIN=vagnihaomarket.stocrm.ru
STOCRM_SID=
STOCRM_BOARD_ID=1097
STOCRM_SOURCE_ID=
# Ответственный за заявки из приложения (USER_ID из users/get_from_filter, wiki WIKI-A-720).
# Если пусто — BFF ищет сотрудника по STOCRM_MANAGER_PHONE в PHONE / WORK_PHONE.
STOCRM_BOOKING_RESPONSIBLE_ID=6507
STOCRM_MANAGER_PHONE=+7 (982) 920-92-23

# Пока SMTP не задан — код 1234 (и для регистрации, и для входа)
DEV_OTP_CODE=1234
# Исходящий :25 на VPS закрыт. Нужен ящик Mail.ru / Яндекс / свой домен.
# Mail.ru: smtp.mail.ru 465 SSL, логин = полный email
# Яндекс: smtp.yandex.ru 465 SSL
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=
BFF_SECRET=change-me

HOST=0.0.0.0
PORT=8080
SERVE_SITE=true

# FCM HTTP v1: JSON сервисного аккаунта (не в git). Путь от папки server/.
FCM_CREDENTIALS=secrets/firebase-adminsdk.json
# Старый Server Key больше не нужен (Google его отключил).
FCM_SERVER_KEY=
POLL_INTERVAL_SEC=90

# Админка /admin/ (если пусто — тот же BFF_SECRET)
ADMIN_PASSWORD=

# Бонусы / кэшбэк 5% с «Успешно реализовано». Мелкие ЗН других воронок < BONUS_MIN_SUM не копятся.
BONUS_PERCENT=5
BONUS_EXPIRE_DAYS=365
BONUS_WARN_DAYS=5
BONUS_MIN_SUM=500
